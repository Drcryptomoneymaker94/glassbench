# Copy to .env (never committed) or set these in the environment. Names only here, no values.

# One Alpaca PAPER account per book. Paper keys start with PK; any other key is refused.
ALPACA_B1_KEY=
ALPACA_B1_SECRET=
ALPACA_B2_KEY=
ALPACA_B2_SECRET=
ALPACA_B3_KEY=
ALPACA_B3_SECRET=
ALPACA_B4_KEY=
ALPACA_B4_SECRET=
ALPACA_B5_KEY=
ALPACA_B5_SECRET=

# Models: DeepSeek for B1, B3 and B5; Anthropic for B2 and B4. FRED for TradingAgents' macro data (B5).
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
FRED_API_KEY=

# Optional. Agent working folders (default ~/arena-workspace), the Python of a venv with TradingAgents v0.7.0
# (default: the Python running the arena), and the harness executables (default: found on PATH).
ARENA_WORKSPACE=
ARENA_TA_PYTHON=
ARENA_CLAUDE_EXE=
ARENA_DSH_CMD=
